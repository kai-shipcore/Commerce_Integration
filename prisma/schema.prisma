enum platform_type {
  amazon
  shopify
  ebay
  walmart
  shiphero
  manual
  Amazon_FBA @map("Amazon FBA")
  Amazon_FBM @map("Amazon FBM")

  @@schema("shipcore")
}

model sc_products {
  id                     BigInt                  @id @default(autoincrement())
  master_sku             String                  @unique @db.VarChar(100)
  product_name           String                  @db.VarChar(255)
  category               String?                 @db.VarChar(100)
  brand                  String?                 @db.VarChar(100)
  status                 String                  @default("active") @db.VarChar(30)
  moq                    Int                     @default(0)
  order_multiple         Int                     @default(1)
  cbm_per_unit           Decimal?                @db.Decimal(12, 4)
  is_custom_sku          Boolean                 @default(false)
  created_at             DateTime                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                @default(now()) @db.Timestamptz(6)
  sub_category           String?                 @db.VarChar(100)
  category_code          String?                 @db.VarChar(10)
  sub_category_code      String?                 @db.VarChar(20)
  sku_pattern_type       String?                 @db.VarChar(30)
  source_web_sku_example String?                 @db.VarChar(150)
  source_market_code     String?                 @db.VarChar(10)
  material_code          String?                 @db.VarChar(20)
  color_code             String?                 @db.VarChar(30)
  color_detail_code      String?                 @db.VarChar(20)
  product_line           String?                 @db.VarChar(20)
  position_code          String?                 @db.VarChar(20)
  size_code              String?                 @db.VarChar(30)
  size_code_2            String?                 @db.VarChar(30)
  vehicle_type_code      String?                 @db.VarChar(20)
  vehicle_class_code     String?                 @db.VarChar(20)
  mirror_type_code       String?                 @db.VarChar(20)
  cover_scope_code       String?                 @db.VarChar(20)
  custom_fit_code        String?                 @db.VarChar(30)
  position_code_2        String?                 @db.VarChar(20)
  material_detail_code   String?                 @db.VarChar(20)
  seat_config_code       String?                 @db.VarChar(30)
  row_config_code        String?                 @db.VarChar(30)
  surface_code           String?                 @db.VarChar(20)
  vehicle_position_code  String?                 @db.VarChar(30)
  make_code              String?                 @db.VarChar(30)
  model_code             String?                 @db.VarChar(50)
  f_number               String?                 @db.VarChar(30)
  fitment_code           String?                 @db.VarChar(50)
  product_type_code      String?                 @db.VarChar(30)
  variant_code           String?                 @db.VarChar(30)
  feature_code           String?                 @db.VarChar(30)
  accessory_group_code   String?                 @db.VarChar(30)
  package_type_code      String?                 @db.VarChar(20)
  parsed_from_web_sku    String?                 @db.VarChar(150)
  parser_version         String?                 @db.VarChar(30)
  parse_status           String?                 @db.VarChar(30)
  parse_note             String?
  product_vehicle_id     BigInt?
  sc_inventory_snapshot  sc_inventory_snapshot[]
  sc_sales_order_items   sc_sales_order_items[]
  sc_sku_mappings        sc_sku_mappings[]

  @@index([category], map: "idx_products_category")
  @@index([category_code], map: "idx_products_category_code")
  @@index([color_code], map: "idx_products_color_code")
  @@index([f_number], map: "idx_products_f_number")
  @@index([material_code], map: "idx_products_material_code")
  @@index([parse_status], map: "idx_products_parse_status")
  @@index([position_code], map: "idx_products_position_code")
  @@index([product_type_code], map: "idx_products_product_type_code")
  @@index([size_code], map: "idx_products_size_code")
  @@index([sku_pattern_type], map: "idx_products_sku_pattern_type")
  @@index([status], map: "idx_products_status")
  @@index([sub_category], map: "idx_products_sub_category")
  @@index([sub_category_code], map: "idx_products_sub_category_code")
  @@index([vehicle_type_code], map: "idx_products_vehicle_type_code")
  @@schema("shipcore")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sc_sku_mappings {
  id             BigInt      @id @default(autoincrement())
  product_id     BigInt
  channel        String      @db.VarChar(50)
  channel_sku    String      @db.VarChar(100)
  linked_sku     String?     @db.VarChar(100)
  production_sku String?     @db.VarChar(100)
  master_sku     String      @db.VarChar(100)
  mapping_type   String      @default("direct") @db.VarChar(30)
  active_from    DateTime    @default(dbgenerated("CURRENT_DATE")) @db.Date
  active_to      DateTime?   @db.Date
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime    @default(now()) @db.Timestamptz(6)
  sc_products    sc_products @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sku_mappings_product_id")

  @@unique([product_id, channel, channel_sku, active_from], map: "uq_sku_mappings_product_channel_sku_period")
  @@index([active_from, active_to], map: "idx_sku_mappings_active_period")
  @@index([channel, channel_sku], map: "idx_sku_mappings_channel_sku")
  @@index([master_sku], map: "idx_sku_mappings_master_sku")
  @@index([product_id], map: "idx_sku_mappings_product_id")
  @@schema("shipcore")
}

model sc_inventory_snapshot {
  id                    BigInt        @id @default(autoincrement())
  snapshot_at           DateTime      @db.Timestamptz(6)
  product_id            BigInt
  master_sku            String        @db.VarChar(100)
  warehouse_code        String        @db.VarChar(50)
  on_hand_qty           Decimal       @default(0) @db.Decimal(12, 2)
  reserved_qty          Decimal       @default(0) @db.Decimal(12, 2)
  available_qty         Decimal       @default(0) @db.Decimal(12, 2)
  backorder_qty         Decimal       @default(0) @db.Decimal(12, 2)
  manual_adjustment_qty Decimal       @default(0) @db.Decimal(12, 2)
  final_usable_qty      Decimal       @default(0) @db.Decimal(12, 2)
  source_system         String?       @db.VarChar(50)
  created_at            DateTime      @default(now()) @db.Timestamptz(6)
  sc_products           sc_products   @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_inventory_snapshot_product_id")
  sc_warehouses         sc_warehouses @relation(fields: [warehouse_code], references: [warehouse_code], onDelete: NoAction, onUpdate: NoAction, map: "fk_inventory_snapshot_warehouse")

  @@unique([snapshot_at, product_id, warehouse_code], map: "uq_inventory_snapshot")
  @@index([master_sku, snapshot_at(sort: Desc)], map: "idx_inventory_snapshot_master_sku_time")
  @@index([product_id, snapshot_at(sort: Desc)], map: "idx_inventory_snapshot_product_time")
  @@index([snapshot_at(sort: Desc)], map: "idx_inventory_snapshot_time")
  @@index([warehouse_code], map: "idx_inventory_snapshot_warehouse")
  @@schema("shipcore")
}

model sc_sales_orders {
  id                      BigInt                 @id @default(autoincrement())
  platform_source         platform_type
  external_order_id       String                 @unique
  order_number            String?
  order_date              DateTime               @db.Timestamptz(6)
  business_date           DateTime?              @db.Date
  order_timezone          String?                @db.VarChar(100)
  order_status            String?
  normalized_order_status String?                @db.VarChar(50)
  financial_status        String?                @db.VarChar(50)
  fulfillment_channel     String?
  sales_channel           String?
  total_price             Decimal?               @db.Decimal(19, 4)
  currency                String?                @default("USD") @db.VarChar(10)
  customer_email          String?
  buyer_email             String?                @db.VarChar(255)
  shipping_country        String?
  is_preorder             Boolean?               @default(false)
  is_counted_in_demand    Boolean?               @default(true)
  cancelled_at            DateTime?              @db.Timestamptz(6)
  closed_at               DateTime?              @db.Timestamptz(6)
  tags                    String?
  raw_data                Json?
  created_at              DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?              @default(now()) @db.Timestamptz(6)
  sc_sales_order_items    sc_sales_order_items[]

  @@unique([platform_source, external_order_id], map: "uq_sales_orders")
  @@index([business_date], map: "idx_sales_orders_business_date")
  @@index([order_date], map: "idx_sales_orders_order_date")
  @@index([platform_source, order_date], map: "idx_sales_orders_platform_order_date")
  @@schema("shipcore")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sc_sales_order_items {
  id                    BigInt          @id @default(autoincrement())
  order_id              BigInt
  platform_source       platform_type?
  external_line_item_id String          @unique(map: "uq_sales_order_items")
  product_id            BigInt?
  master_sku            String?         @db.VarChar(100)
  channel_sku           String?
  sku                   String?
  product_name          String?
  quantity              Int
  refunded_quantity     Int             @default(0)
  cancelled_quantity    Int             @default(0)
  fulfilled_quantity    Int             @default(0)
  demand_quantity       Int?            @default(dbgenerated("GREATEST(((quantity - COALESCE(refunded_quantity, 0)) - COALESCE(cancelled_quantity, 0)), 0)"))
  unit_price            Decimal?        @db.Decimal(19, 4)
  line_total            Decimal?        @db.Decimal(19, 4)
  discount_amount       Decimal         @default(0) @db.Decimal(19, 4)
  net_sales_amount      Decimal?        @db.Decimal(19, 4)
  item_tax              Decimal         @default(0) @db.Decimal(19, 4)
  shipping_price        Decimal         @default(0) @db.Decimal(19, 4)
  currency              String?         @db.VarChar(10)
  item_status           String?
  fulfillment_status    String?
  is_removed            String          @default("N") @db.Char(1)
  is_preorder           Boolean         @default(false)
  is_counted_in_demand  Boolean         @default(true)
  business_date         DateTime?       @db.Date
  warehouse_code        String?         @db.VarChar(50)
  raw_data              Json?
  created_at            DateTime        @default(now()) @db.Timestamptz(6)
  updated_at            DateTime        @default(now()) @db.Timestamptz(6)
  sc_sales_orders       sc_sales_orders @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sales_order_items_order")
  sc_products           sc_products?    @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sales_order_items_product_id")
  sc_warehouses         sc_warehouses?  @relation(fields: [warehouse_code], references: [warehouse_code], onDelete: NoAction, onUpdate: NoAction, map: "fk_sales_order_items_warehouse")

  @@index([business_date], map: "idx_sales_order_items_business_date")
  @@index([channel_sku], map: "idx_sales_order_items_channel_sku")
  @@index([master_sku], map: "idx_sales_order_items_master_sku")
  @@index([master_sku, business_date], map: "idx_sales_order_items_master_sku_date")
  @@index([order_id], map: "idx_sales_order_items_order_id")
  @@index([platform_source], map: "idx_sales_order_items_platform")
  @@index([product_id, business_date], map: "idx_sales_order_items_product_date")
  @@index([product_id], map: "idx_sales_order_items_product_id")
  @@index([sku], map: "idx_sales_order_items_sku")
  @@schema("shipcore")
}

